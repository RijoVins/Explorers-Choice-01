# Explorers Choice backend — environment configuration.
# Copy this file to `.env` and fill in real values before deploying.
#
# REQUIRED, fail-closed:
#   SECRET_KEY          — long random value signing customer sessions.
#                         Generate with:
#                         python -c "import secrets;print(secrets.token_urlsafe(48))"
#   ADMIN_API_KEY       — shared secret for admin operations in this deployment.
#
# PRODUCTION / STAGING:
#   COOKIE_SECURE       — leave unset/true (backend runs behind HTTPS).
#
# LOCAL DEVELOPMENT ONLY (never in production):
#   EXPLORERS_ALLOW_INSECURE=true   bypasses the placeholder-secret guard.
#   COOKIE_SECURE=false             cookies are sent over plain http.
#
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","http://localhost:3100"]

SECRET_KEY=
ADMIN_API_KEY=

DATABASE_PROVIDER=mysql

# MySQL / TiDB Cloud connection
MYSQL_HOST=
MYSQL_PORT=4000
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_MODE=verify-ca
MYSQL_SSL_CA=

# ── Google OAuth ("Continue with Google") ──────────────────────────────────────
# Until BOTH GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set, GET
# /api/auth/google returns 503 "Google sign-in is not configured."
#
# GOOGLE_REDIRECT_URI must match EXACTLY one of:
#   - the "Authorized redirect URI" registered in Google Cloud Console, and
#   - the origin this deployment serves the browser from.
# It must be the FRONTEND origin + /api/auth/google/callback, not the backend
# origin, because the session cookie is set on the host that answers the
# callback and the browser must send it back to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.explorerschoice.online/api/auth/google/callback
# Origin the callback redirects to after sign-in (the frontend, no trailing /).
GOOGLE_RETURN_URL=https://www.explorerschoice.online

# COOKIE_SECURE=false
# EXPLORERS_ALLOW_INSECURE=true
