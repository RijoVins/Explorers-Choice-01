# Explorers Choice backend — environment configuration.
# Copy this file to `.env` and fill in real values before deploying.
#
# REQUIRED, fail-closed:
#   SECRET_KEY          — long random value signing customer sessions. Segreacted
#                         from the frontend. Generate with:
#                         python -c "import secrets;print(secrets.token_urlsafe(48))"
#   ADMIN_API_KEY       — shared secret for admin operations in this deployment.
#
# PRODUCTION / STAGING:
#   COOKIE_SECURE       — leave unset/true (backend runs behind HTTPS).
#
# LOCAL DEVELOPMENT ONLY (never in production):
#   EXPLORERS_ALLOW_INSECURE=true   bypasses the placeholder-secret guard,
#   COOKIE_SECURE=false             cookies are sent over plain http.
#
# ── DATABASE PROVIDER SELECTION ───────────────────────────────────────────
# DATABASE_PROVIDER=mysql     MySQL-compatible database (MySQL 8 / MariaDB /
#                             TiDB). Alembic is DISABLED: this application
#                             never creates, alters or drops those tables, and
#                             startup only runs a read-only connectivity check.
# DATABASE_PROVIDER=supabase  The Supabase-hosted PostgreSQL database. Alembic
#                             runs at startup exactly as it always has.
#
# No automatic fallback: if the selected database is unreachable the backend
# refuses to start. It never silently switches to the other provider.
#
# Put real connection details only in the local, uncommitted `.env` file.
DATABASE_PROVIDER=supabase

# All developers must use the same shared database. Share the variable name
# and approved connection details through your team's secret-sharing process.
# Used only when DATABASE_PROVIDER=supabase.
DATABASE_URL=postgresql+psycopg://<username>:<password>@<shared-host>:5432/<database-name>

# Used only when DATABASE_PROVIDER=mysql. Discrete fields so a password
# containing @ : / ? # & cannot corrupt the URL. Set MYSQL_URL instead of
# these four if you prefer a single connection string.
# MYSQL_HOST=<mysql-host>
# MYSQL_PORT=3306
# MYSQL_DATABASE=<database-name>
# MYSQL_USER=<username>
# MYSQL_PASSWORD=<password>
# MYSQL_URL=mysql+pymysql://<username>:<password>@<host>:3306/<database-name>

# TLS is mandatory. "verify-full" (the default) verifies the server certificate
# against MYSQL_SSL_CA and also verifies the hostname. "verify-ca" verifies the
# chain only. Any other value, including unverified TLS, is rejected at startup.
#
# TiDB Cloud publishes no CA certificate of its own (the issuer is Let's Encrypt
# and may change), so copy your OS root CA bundle rather than a single root:
#   cp /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
#      backend/certs/tidb-cloud-ca.pem      # Fedora/RHEL
#   Debian/Ubuntu: /etc/ssl/certs/ca-certificates.crt
#   macOS:         /etc/ssl/cert.pem
# Keep it in backend/certs/ (git-ignored), never in the repository.
# MYSQL_SSL_MODE=verify-full
# MYSQL_SSL_CA=/absolute/path/to/backend/certs/tidb-cloud-ca.pem

# Connection pool sizing. Lower MYSQL_POOL_SIZE if your host caps connections.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# MYSQL_POOL_SIZE=10
# MYSQL_MAX_OVERFLOW=20
# MYSQL_POOL_RECYCLE=1800

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","http://localhost:3100","https://www.explorerschoice.online","https://explorerschoice.online"]

SECRET_KEY=
ADMIN_API_KEY=

# COOKIE_SECURE=false
# EXPLORERS_ALLOW_INSECURE=true

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth ("Sign in with Google")
#
# 1. Create an OAuth 2.0 Client ID in Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
#    - Application type: "Web application"
#    - Authorized redirect URIs: add the GOOGLE_REDIRECT_URI value below
#
# 2. Copy GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET into your local .env.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# GOOGLE_RETURN_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Email Notifications (Tour Bookings & Admin Alerts)
#
# Recipient email address for booking notifications (defaults to infoexplorerschoice@gmail.com):
ADMIN_NOTIFICATION_EMAIL=infoexplorerschoice@gmail.com

# SMTP settings for sending emails (e.g. Gmail, SendGrid, Amazon SES, Mailgun, etc.):
# For Gmail:
#   1. Enable 2-Step Verification in your Google Account
#   2. Generate an "App Password" at https://myaccount.google.com/apppasswords
#   3. Put your Gmail in SMTP_USERNAME and the 16-character App Password in SMTP_PASSWORD
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=infoexplorerschoice@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=infoexplorerschoice@gmail.com
SMTP_FROM_NAME=Explorers Choice
SMTP_USE_TLS=true
SMTP_USE_SSL=false