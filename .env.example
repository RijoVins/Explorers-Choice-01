# Explorers Choice — environment configuration (placeholders only).
# Copy to the backend's local, git-ignored .env and fill in real values.
# Never commit real credentials.

# ── Which database the application uses ─────────────────────────────────────
# Allowed values: "mysql" | "supabase"
#
#   mysql     -> MySQL-compatible database (MySQL 8 / MariaDB / TiDB).
#                Alembic migrations are DISABLED; the schema is owned outside
#                this application and is never created/altered automatically.
#   supabase  -> the Supabase-hosted PostgreSQL database (DATABASE_URL below).
#                Alembic migrations run at startup, as they always have.
#
# There is no automatic fallback. If the selected database is unreachable the
# backend refuses to start rather than quietly using the other one.
DATABASE_PROVIDER=supabase

# ── Supabase / PostgreSQL (used only when DATABASE_PROVIDER=supabase) ──────
# All developers must use the same shared database. Share the variable name
# and approved connection details through your secret-sharing process.
DATABASE_URL=postgresql+psycopg://<username>:<password>@<shared-host>:5432/<database-name>

# ── MySQL / TiDB Cloud (used only when DATABASE_PROVIDER=mysql) ───────────
# Discrete fields, so a password containing @ : / ? # & stays safe.
# Alternatively set MYSQL_URL instead of these four.
# MYSQL_HOST=<mysql-host>
# MYSQL_PORT=3306
# MYSQL_DATABASE=<database-name>
# MYSQL_USER=<username>
# MYSQL_PASSWORD=<password>

# TLS is mandatory. "verify-full" (the default) checks the server certificate
# against MYSQL_SSL_CA and also checks the hostname. "verify-ca" checks the
# chain only. Any other value, including unverified TLS, is rejected at startup.
# TiDB Cloud publishes no CA of its own (issuer is Let's Encrypt, and may change),
# so copy your OS root CA bundle here rather than a single root:
#   Fedora/RHEL  /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
#   Debian/Ubuntu /etc/ssl/certs/ca-certificates.crt
#   macOS         /etc/ssl/cert.pem
# MYSQL_SSL_MODE=verify-full
# MYSQL_SSL_CA=/absolute/path/to/ca-certificate.pem

# Connection pool sizing. Lower MYSQL_POOL_SIZE if your host caps connections.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# MYSQL_POOL_SIZE=10
# MYSQL_MAX_OVERFLOW=20
# MYSQL_POOL_RECYCLE=1800

# ── Application secrets ────────────────────────────────────────────────────
# Generate SECRET_KEY with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-customer-secret
ADMIN_API_KEY=change-me-admin-key
EXPLORERS_ALLOW_INSECURE=true
ENVIRONMENT=development
COOKIE_SECURE=false
