/backend/venv/
/backend/.venv/
/.venv/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
*.db
/dist/
/build/

# Environment files
.env
.env.local
!.env.example

# Database TLS certificates (per-developer, e.g. TiDB Cloud CA)
/backend/certs/
